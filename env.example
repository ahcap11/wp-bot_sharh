# ─────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────
# Public HTTP port for health, readiness, and Meta webhooks. Railway supplies PORT.
PORT=8080
NODE_ENV=development
# Internal WebSocket monitoring port.
HEALTH_PORT=3001

# ─────────────────────────────────────────────────────────────
# AI Configuration
# Set the provider and the matching API key below.
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# ─────────────────────────────────────────────────────────────
# Chat History Configuration
# ─────────────────────────────────────────────────────────────
MAX_HISTORY_LENGTH=50
RESPONSE_DELAY=1000

# ─────────────────────────────────────────────────────────────
# Logging Configuration (error | warn | info | debug)
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# AI Service Configuration
# ─────────────────────────────────────────────────────────────
AI_MAX_TOKENS=150
AI_TEMPERATURE=0.7
AI_SMART_ROUTING_ENABLED=true
AI_MAX_CALLS_PER_CONVERSATION=8
AI_MAX_CALLS_PER_NUMBER_PER_DAY=20
AI_MAX_INPUT_CHARS=2000
AI_ABUSE_COOLDOWN_MS=600000
AI_OFFTOPIC_STRIKES_BEFORE_COOLDOWN=3
AI_MIN_INTERVAL_MS=1500
AI_CONVERSATION_IDLE_RESET_MS=86400000

# ─────────────────────────────────────────────────────────────
# WebSocket Security
# If set, clients must connect with ?token=<value>. Leave empty to disable.
# ─────────────────────────────────────────────────────────────
WS_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# Google Sheets Integration
# ─────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
# Provide credentials either inline as JSON or as a path to a key file
# kept OUTSIDE the repository. Never commit the actual key.
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_CREDENTIALS_PATH=

# ─────────────────────────────────────────────────────────────
# SHARH Backend Integration (canonical production path)
# The bot uses a narrowly scoped service token. It never receives PostgreSQL
# credentials and never bypasses SHARH authorization/publication rules.
# ─────────────────────────────────────────────────────────────
SHARH_API_ENABLED=false
SHARH_API_BASE_URL=https://your-sharh-api.example.com
SHARH_API_SERVICE_TOKEN=generate-a-long-random-service-token
SHARH_API_BOT_ID=whatsapp-funnel
SHARH_API_TIMEOUT_MS=8000
# Migration/development fallback only. Set false after SHARH API activation.
SHARH_API_ALLOW_NEON_FALLBACK=false
SHARH_API_PUBLIC_LISTING_FIELDS=id,public_code,title,subtitle,sector,region,emirate,description,price,asking,price_int,revenue,ebitda,monthly_net_profit,tags,ribbon,sale_type,match_score,match_reasons,match_gaps,hard_gap_labels,relaxation_distance,annual_profit_aed,profit_basis,roi_pct,passive_evidence,passive_evidence_label,parsed_price_aed
# Durable local outbox retry controls.
SHARH_API_SYNC_INTERVAL_MS=30000
SHARH_API_SYNC_MAX_ATTEMPTS=12
SHARH_API_SYNC_BATCH_SIZE=20
SHARH_API_CONTEXT_CACHE_MS=30000

# ─────────────────────────────────────────────────────────────
# Legacy Neon Read-Only Search (temporary migration fallback)
# This is never used when SHARH_API_ALLOW_NEON_FALLBACK=false.
# Use a READ-ONLY database user. The app never writes to this DB.
# ─────────────────────────────────────────────────────────────
NEON_SEARCH_ENABLED=false
NEON_READONLY_DATABASE_URL=
NEON_SEARCH_TABLE_NAME=asset_sales
NEON_SEARCHABLE_COLUMNS=title,subtitle,sector,region,emirate,description,price,revenue,tags,ribbon,sale_type
NEON_SEARCH_LIMIT=5

# ─────────────────────────────────────────────────────────────
# State Persistence
# Survives restarts/redeploys (chat history, roles, lead progress, and retry outbox).
# In Docker, mount the directory as a volume to keep state. This file-backed
# store is for one-instance pilot deployments; use SHARH PostgreSQL for replicas.
# ─────────────────────────────────────────────────────────────
PERSISTENCE_ENABLED=true
# Required when SHARH_API_ENABLED=true.
PERSISTENCE_PATH=/app/data/state.json

# ─────────────────────────────────────────────────────────────
# Access Control (allowlist + rate limit)
# ALLOWED_NUMBERS: comma-separated phone numbers (digits only, with country code).
# ─────────────────────────────────────────────────────────────
ALLOWLIST_ENABLED=false
ALLOWED_NUMBERS=

# ─────────────────────────────────────────────────────────────
# WhatsApp transport — current pilot path
# ─────────────────────────────────────────────────────────────
# Baileys reuses the existing WhatsApp Web linked-device connection. It does
# not require Meta Cloud API credentials or a public Meta webhook.
WHATSAPP_TRANSPORT=baileys
# Must be inside the persistent /app/data Railway volume.
WHATSAPP_AUTH_DIR=/app/data/whatsapp-auth
BAILEYS_RECONNECT_BASE_DELAY_MS=5000
BAILEYS_RECONNECT_MAX_DELAY_MS=120000
# Protects https://<bot-host>/qr. Required in production; use 24+ random chars.
QR_ACCESS_TOKEN=replace-with-a-long-random-token

# Future official Cloud API switch. Leave empty during the Baileys pilot.
# Switching later only requires WHATSAPP_TRANSPORT=cloud and these values;
# funnel, SHARH API, and database integration remain unchanged.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_API_VERSION=v26.0
WHATSAPP_CLOUD_WEBHOOK_PATH=/webhooks/whatsapp
WHATSAPP_CLOUD_SEND_TIMEOUT_MS=10000
WHATSAPP_CLOUD_WEBHOOK_MAX_BODY_BYTES=1048576

# --- Legacy Neon listing exposure ---
# Applies only to the temporary Neon fallback. List client-safe columns only.
NEON_PUBLIC_COLUMNS=

# --- Roles & group filtering (Step 6) ---
# The bot is already in sales mode by default. Keep this false so customers
# cannot escape the sales funnel by typing commands such as "support mode".
ROLE_SWITCH_ENABLED=false
# Ignore group / broadcast / channel messages (1:1 inbound only). Default true.
IGNORE_GROUPS=true

# --- Rate limiting (Step 7) ---
# Enabled by default to prevent spam / cost abuse on a public number.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_MS=60000

# Versioned sales behavior and scoring
SALES_PLAYBOOK_VERSION=sharh-sales-v1
